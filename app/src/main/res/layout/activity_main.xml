<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="200dp"
    android:background="#FAF8FC">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate Tip"
        android:textSize="14sp"
        android:textColor="#444444"
        android:layout_marginBottom="14dp"/>

    <!-- Bill Amount -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/billLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Bill Amount"
        app:boxBackgroundColor="#F4DDE3"
        app:startIconDrawable="@android:drawable/ic_menu_edit">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/billAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Tip Percentage -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tipLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:hint="Tip Percentage"
        app:boxBackgroundColor="#F4DDE3"
        app:startIconDrawable="@android:drawable/ic_menu_info_details">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tipPercentage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Round up -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="26dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Round up tip?"
            android:textSize="14sp"
            android:textColor="#444444"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/roundUpSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="#FFFFFF"
            app:trackTint="#D9BFC5"/>
    </LinearLayout>

    <!-- Result -->
    <TextView
        android:id="@+id/tipAmountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tip Amount: $0.00"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#101820"
        android:gravity="center"
        android:layout_marginTop="38dp"/>

</LinearLayout>